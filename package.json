{
  "name": "aifos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first financial intelligence workspace for SMEs",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.14.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit && pnpm --filter @aifos/ai-contracts typecheck && pnpm --filter @aifos/cloud-gateway typecheck && tsc --project apps/desktop/tsconfig.json --noEmit",
    "build:cloud-gateway": "pnpm --filter @aifos/cloud-gateway build",
    "build:desktop": "pnpm --filter @aifos/desktop build",
    "dev:setup": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/setup-development.ps1",
    "dev:clean": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/clean-development.ps1",
    "size:check": "node scripts/check-workspace-size.mjs",
    "benchmark:pilot": "node scripts/run-pilot-benchmark.mjs",
    "benchmark:pilot:clean": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/clean-pilot-benchmark.ps1",
    "benchmark:desktop-smoke": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/measure-desktop-smoke.ps1",
    "desktop:dev": "node scripts/run-tauri.mjs dev",
    "desktop:info": "node scripts/run-tauri.mjs info",
    "release:check": "node scripts/check-release.mjs",
    "release:prepare": "node scripts/prepare-release-resources.mjs",
    "release:build": "node scripts/build-release.mjs",
    "rust:format:check": "node scripts/run-cargo.mjs format",
    "rust:check": "node scripts/run-cargo.mjs check",
    "rust:test": "node scripts/run-cargo.mjs test",
    "rust:clippy": "node scripts/run-cargo.mjs clippy",
    "python:test": "node scripts/run-python-tests.mjs",
    "test": "vitest run",
    "licenses:generate": "node scripts/report-licenses.mjs",
    "licenses:check": "node scripts/report-licenses.mjs --check",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "secrets:check": "node scripts/check-secrets.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm python:test && pnpm build:cloud-gateway && pnpm build:desktop && pnpm rust:format:check && pnpm rust:test && pnpm rust:clippy && pnpm release:check && pnpm licenses:check && pnpm sbom:check && pnpm secrets:check && pnpm size:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.14.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
