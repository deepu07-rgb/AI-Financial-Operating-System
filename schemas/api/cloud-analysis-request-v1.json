{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aifos.local/cloud-analysis-request-v1.json",
  "title": "AIFOS cloud analysis request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "tenantId",
    "workspaceReference",
    "task",
    "mode",
    "question",
    "consent",
    "context"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspaceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task": {
      "enum": [
        "cash_scenario",
        "overdue_exposure",
        "payment_priority",
        "profit_movement",
        "supplier_trend"
      ]
    },
    "mode": { "enum": ["economy", "standard"] },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "grantedAtMs",
        "categories",
        "approximateRecordCount"
      ],
      "properties": {
        "receiptId": { "type": "string", "format": "uuid" },
        "grantedAtMs": { "type": "integer" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "approved_invoice",
              "dashboard_metric",
              "offline_report",
              "rule_event",
              "user_scenario"
            ]
          }
        },
        "approximateRecordCount": { "type": "integer", "minimum": 0 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records"],
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "category", "fields"],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "category": {
                "enum": [
                  "approved_invoice",
                  "dashboard_metric",
                  "offline_report",
                  "rule_event",
                  "user_scenario"
                ]
              },
              "fields": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 64,
                "additionalProperties": {
                  "type": ["boolean", "number", "string", "null"]
                }
              }
            }
          }
        }
      }
    }
  }
}
