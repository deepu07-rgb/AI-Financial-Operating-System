{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "AIFOS Project",
    "category": "Finance",
    "shortDescription": "Offline-first finance operations workspace",
    "longDescription": "AIFOS is a local finance operations workspace with document review, deterministic rules, reports, backups, and controlled connectors.",
    "resources": ["release-resources/**/*"],
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      },
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "sign-windows.ps1",
          "%1"
        ]
      }
    }
  }
}
